<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. SOS Emergency Shortcut -->
    <shortcut
        android:shortcutId="sos_emergency"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sos"
        android:shortcutShortLabel="@string/shortcut_sos_short"
        android:shortcutLongLabel="@string/shortcut_sos_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aistudio.durga.safety"
            android:targetClass="com.example.MainActivity">
            <extra
                android:name="EXTRA_SHORTCUT_ACTION"
                android:value="ACTION_SOS" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

